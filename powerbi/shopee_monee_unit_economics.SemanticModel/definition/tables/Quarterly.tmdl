table Quarterly
	lineageTag: 243c6410-cc66-45e4-8e70-045c2ddb338d

	measure '+29% vs prior 4 quarters' = VAR s = MAXX(ALL(Quarterly), Quarterly[Sort]) VAR cur = CALCULATE(SUM(Quarterly[GMV_bn]), ALL(Quarterly), Quarterly[Sort] > s - 4) RETURN "US$" & FORMAT(cur, "0.0") & " bn"
		displayFolder: KPI p1
		lineageTag: c1bc5083-cfc2-4954-8572-f2d3e3f55cdd

	measure 'AOV US$9.12 per order' = VAR s = MAXX(ALL(Quarterly), Quarterly[Sort]) VAR cur = CALCULATE(SUM(Quarterly[Orders_bn]), ALL(Quarterly), Quarterly[Sort] > s - 4) RETURN FORMAT(cur, "0.0") & " bn"
		displayFolder: KPI p1
		lineageTag: 96d08b17-5ed1-4ea0-8e07-68be921319c7

	measure 'Q2 26, about 5% in Q3 22' = VAR s = MAXX(ALL(Quarterly), Quarterly[Sort]) RETURN FORMAT(CALCULATE(MAX(Quarterly[CoreTake]), ALL(Quarterly), Quarterly[Sort] = s), "0.0%")
		displayFolder: KPI p1
		lineageTag: 75e4ab96-1551-4413-8622-827369b4954c

	measure 'Q2 26, about 1.2% in Q1 23' = VAR s = MAXX(ALL(Quarterly), Quarterly[Sort]) RETURN FORMAT(CALCULATE(MAX(Quarterly[EBITDA_GMV]), ALL(Quarterly), Quarterly[Sort] = s), "0.00%")
		displayFolder: KPI p1
		lineageTag: 417bbc5b-b652-4d71-a4de-94c0f5792c43

	measure 'Q2 26 adj. EBITDA / gross orders' = VAR s = MAXX(ALL(Quarterly), Quarterly[Sort]) RETURN "US$" & FORMAT(CALCULATE(MAX(Quarterly[EBITDA_per_order]), ALL(Quarterly), Quarterly[Sort] = s), "0.000")
		displayFolder: KPI p1
		lineageTag: 7a74fb49-ae6d-4c1b-b529-52e39bed2446

	measure 'Q2 26, incl. off-book loans' = VAR s = MAXX(ALL(Quarterly), Quarterly[Sort]) RETURN "US$" & FORMAT(CALCULATE(MAX(Quarterly[Loans_bn]), ALL(Quarterly), Quarterly[Sort] = s), "0.0") & " bn"
		displayFolder: KPI p2
		lineageTag: 84eae2d4-3bca-4978-a65a-3e5187dbbe3e

	measure 'vs Q2 25, same loan measure' = VAR s = MAXX(ALL(Quarterly), Quarterly[Sort]) RETURN "+" & FORMAT(CALCULATE(MAX(Quarterly[LoanYoY]), ALL(Quarterly), Quarterly[Sort] = s), "0%")
		displayFolder: KPI p2
		lineageTag: cccfa058-fc43-45fc-8f67-bc2f1d4cf60b

	measure 'past due 90+ days, Q2 26' = VAR s = MAXX(ALL(Quarterly), Quarterly[Sort]) RETURN FORMAT(CALCULATE(MAX(Quarterly[NPL]), ALL(Quarterly), Quarterly[Sort] = s), "0.0%")
		displayFolder: KPI p2
		lineageTag: 79ad7fbc-1010-4ca9-aff6-731f71278179

	measure 'NPL / loan book a year earlier' = VAR s = MAXX(ALL(Quarterly), Quarterly[Sort]) RETURN FORMAT(CALCULATE(MAX(Quarterly[NPL_Seasoned]), ALL(Quarterly), Quarterly[Sort] = s), "0.0%")
		displayFolder: KPI p2
		lineageTag: 66ba8e73-921c-4f5e-a3b4-4cdebc7edb36

	measure 'Q2 26, was 31.4% in Q4 23' = VAR s = MAXX(ALL(Quarterly), Quarterly[Sort]) RETURN FORMAT(CALCULATE(MAX(Quarterly[MoneeMargin]), ALL(Quarterly), Quarterly[Sort] = s), "0.0%")
		displayFolder: KPI p2
		lineageTag: 6f86cab3-9765-4a27-87a5-ba5a6bd1d504

	measure 'Profit quarter' = VAR v = SUM(Quarterly[EBITDA_GMV]) RETURN IF(NOT ISBLANK(v) && v >= 0, v)
		formatString: 0.0%
		displayFolder: Chart
		lineageTag: ab2ddce5-84c7-433c-82f2-bf59e0768fb8

	measure 'Loss quarter' = VAR v = SUM(Quarterly[EBITDA_GMV]) RETURN IF(v < 0, v)
		formatString: 0.0%
		displayFolder: Chart
		lineageTag: 6b1017f3-c4f5-411a-b382-06b67fe8d902

	measure 'Loans (current measure)' = CALCULATE(SUM(Quarterly[Loans_bn]), Quarterly[CurrentLoanBasis] = TRUE())
		formatString: 0.0
		displayFolder: Chart
		lineageTag: 10831c3d-22f1-4791-9e1f-4b27c4e3ce5e

	measure 'Loans (older on-book measures)' = CALCULATE(SUM(Quarterly[Loans_bn]), Quarterly[CurrentLoanBasis] = FALSE())
		formatString: 0.0
		displayFolder: Chart
		lineageTag: 2503c987-8016-45d4-8c3a-b483fd4111ca

	measure 'H1 quarter' = CALCULATE(SUM(Quarterly[EBITDA_m]), Quarterly[Half] = "H1", Quarterly[Sort] >= 21)
		formatString: #,0
		displayFolder: Chart
		lineageTag: 89e547d2-5306-4015-9507-59bdab0fad38

	measure 'H2 quarter' = CALCULATE(SUM(Quarterly[EBITDA_m]), Quarterly[Half] = "H2", Quarterly[Sort] >= 21)
		formatString: #,0
		displayFolder: Chart
		lineageTag: a485e5ae-905a-4be9-8dae-e67a4cfbe0a9

	measure 'Fees + ads' = SUM(Quarterly[CoreTake])
		formatString: 0.0%
		displayFolder: Chart
		lineageTag: ad0953fe-39b4-43d0-8666-0a4be669834f

	measure 'Logistics (VAS)' = SUM(Quarterly[VASTake])
		formatString: 0.0%
		displayFolder: Chart
		lineageTag: 212a4a13-8f4b-4a6e-af9f-b288c0d2138c

	measure 'GMV (US$ bn)' = SUM(Quarterly[GMV_bn])
		formatString: 0.0
		displayFolder: Chart
		lineageTag: a1a7e7cd-7ce3-4543-b842-c7623b343e8d

	measure 'Gross orders (bn)' = SUM(Quarterly[Orders_bn])
		formatString: 0.0
		displayFolder: Chart
		lineageTag: 7557f859-0a07-4d9e-80b4-d55be027f776

	measure 'Reported NPL 90+' = SUM(Quarterly[NPL])
		formatString: 0.0%
		displayFolder: Chart
		lineageTag: 078a28d8-1c67-4cf9-af36-83ce71c0ccb9

	measure 'NPL / loans a year earlier' = SUM(Quarterly[NPL_Seasoned])
		formatString: 0.0%
		displayFolder: Chart
		lineageTag: e8f73caa-cb45-4889-87c9-dc77e4608635

